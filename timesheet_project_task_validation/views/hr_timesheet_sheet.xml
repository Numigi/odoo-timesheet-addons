<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="hr_timesheet_sheet_form_inherit_task_validation" model="ir.ui.view">
            <field name="name">hr_timesheet.sheet.form.timesheet_task_validation</field>
            <field name="model">hr_timesheet.sheet</field>
            <field name="inherit_id" ref="hr_timesheet_sheet.hr_timesheet_sheet_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='add_line_task_id']" position="attributes">
                    <attribute name="context">{'default_project_id': add_line_project_id, 'timesheet_task_validation': True}</attribute>
                </xpath>

                <xpath expr="//button[@name='button_add_line']" position="attributes">
                    <attribute name="context">{'timesheet_task_validation': True}</attribute>
                </xpath>

            </field>
        </record>
</odoo>
